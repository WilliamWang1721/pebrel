+        let first = Lease::acquire("test-exclusive-tunnel").unwrap();
+        assert!(Lease::acquire("test-exclusive-tunnel").is_none());
+        drop(first);
+        assert!(Lease::acquire("test-exclusive-tunnel").is_some());
